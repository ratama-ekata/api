# ==============================================================================
# Environment Configuration Template (.env.example)
# Copy this file to .env and replace placeholder values with your credentials
# ==============================================================================

# PostgreSQL Connection String
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ratamaekata_db

# Security & JWT Token Authentication
SECRET_KEY=replace_with_a_secure_random_32_byte_secret_key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Initial Default Accounts (Auto-seeded on startup)
SYSADMIN_USERNAME=sysadmin
SYSADMIN_EMAIL=sysadmin@ratamaekata.gov.lk
SYSADMIN_PASSWORD=SysAdmin@2026!
SYSADMIN_PHONE=+94770000001

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@ratamaekata.gov.lk
ADMIN_PASSWORD=Admin@2026!
ADMIN_PHONE=+94770000002

# AWS S3 Cloud Storage Credentials
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
AWS_REGION=us-east-1
AWS_S3_BUCKET_NAME=your_s3_bucket_name

# Optional AWS S3 Overrides
# AWS_S3_CUSTOM_DOMAIN=cdn.ratamaekata.gov.lk
# AWS_ENDPOINT_URL=http://localhost:9000
